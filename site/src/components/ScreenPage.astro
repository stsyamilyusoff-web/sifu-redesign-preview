---
// The screen page: ONE page holding everything about a screen.
// Data comes from src/data/screens.json (generated by scripts/compare/site-data.mjs).
import screensData from '../data/screens.json';

interface Props { slug: string }
const { slug } = Astro.props;
const s = screensData.find((x) => x.slug === slug);
if (!s) throw new Error(`no screen data for slug ${slug}`);

// pilot serves from the pub-repo root, so pipeline assets resolve absolutely
const A = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<p class="lead">{s.summary}</p>

{s.preKit && (
	<aside class="prekit">
		<b>PRE-KIT · reconciliation pending.</b> This mock predates the element library (locked 10-Jul-2026). It reconciles to the kit in the dedicated reconciliation session and does not represent current component direction - read it for structure and content decisions, not for visual grammar.
	</aside>
)}

<p class="rowlinks">
	<a class="pill solid" href={A + s.mock} target="_blank" rel="noopener">Open the full mock ↗</a>
	{s.decision && <a class="pill" href={A + s.decision.board} target="_blank" rel="noopener">Decision record ↗</a>}
</p>

{s.decision && (
	<aside class="prov">
		<b>Design provenance:</b> {s.decision.headline}
		<div class="provcols">
			<div>
				<h4>Pinned references</h4>
				<ul>{s.decision.pinned.map((p) => <li><b>{p.ref}</b> ({p.tier}) · {p.why}</li>)}</ul>
			</div>
			<div>
				<h4>Dropped</h4>
				<ul>{s.decision.dropped.map((p) => <li><b>{p.ref}</b> · {p.why}</li>)}</ul>
				<h4>Sifututor-original</h4>
				<ul>{s.decision.ours.map((o) => <li>{o}</li>)}</ul>
			</div>
		</div>
	</aside>
)}

<h2>States · live vs redesign</h2>
{s.states.map((st) => (
	<section class="state">
		<h3>{st.label} <a class="slider" href={`${A}compare/index.html?id=${st.before ? 'changed' : 'new'}-${st.name}.png`} target="_blank" rel="noopener">slider view ↗</a></h3>
		<div class="pair">
			<figure>
				<figcaption class="live">Live now</figcaption>
				{st.before
					? <img src={A + st.before} alt={`${s.name} · ${st.label} · live`} loading="lazy" />
					: <div class="ghost">Net-new or no live capture</div>}
			</figure>
			<span class="arr">→</span>
			<figure>
				<figcaption class="new">New</figcaption>
				<img src={A + st.after} alt={`${s.name} · ${st.label} · redesign`} loading="lazy" />
			</figure>
		</div>
	</section>
))}

<style>
	.lead { font-size: 1.05rem; }
	.rowlinks { display: flex; gap: 0.6rem; flex-wrap: wrap; }
	.pill {
		display: inline-block; border: 1px solid var(--sl-color-accent); color: var(--sl-color-accent);
		border-radius: 999px; padding: 0.45rem 1rem; font-weight: 700; font-size: 0.85rem; text-decoration: none;
	}
	.pill.solid { background: var(--sl-color-accent); color: #fff; }
	.prov {
		background: var(--sl-color-accent-low); border: 1px solid var(--sl-color-accent);
		border-radius: 0.8rem; padding: 0.9rem 1.1rem; font-size: 0.92rem;
	}
	.prekit {
		background: var(--sifu-amber-tint, #FEF3E2); border: 1px solid var(--sifu-amber, #b45309);
		border-radius: 0.8rem; padding: 0.9rem 1.1rem; font-size: 0.92rem; margin: 0.8rem 0;
	}
	.prov h4 { margin: 0.7rem 0 0.2rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; }
	.prov ul { margin: 0.2rem 0; padding-left: 1.1rem; }
	.provcols { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.4rem; }
	@media (max-width: 640px) { .provcols { grid-template-columns: 1fr; } }
	.state h3 { text-transform: capitalize; }
	.state h3 .slider { font-size: 0.72rem; font-weight: 700; margin-left: 0.6rem; text-decoration: none; color: var(--sl-color-accent); }
	.pair { display: flex; align-items: flex-start; justify-content: center; gap: 0.9rem; }
	.pair figure { margin: 0; flex: 0 1 auto; min-width: 0; text-align: center; }
	.pair img, .pair .ghost { max-height: 72vh; width: auto; max-width: 100%; border-radius: 0.9rem; border: 1px solid var(--sl-color-gray-5); }
	.pair .ghost {
		width: 160px; height: 340px; border: 2px dashed var(--sl-color-accent-low); display: flex;
		align-items: center; justify-content: center; text-align: center; padding: 1rem;
		color: var(--sl-color-gray-3); font-size: 0.8rem;
	}
	.pair figcaption { font-size: 0.7rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 0.35rem; }
	.pair figcaption.new { color: var(--sl-color-accent); }
	.pair .arr { align-self: center; color: var(--sl-color-gray-3); font-weight: 800; }
</style>
