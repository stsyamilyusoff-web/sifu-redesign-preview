---
// Stage overview as scannable rows (fixed scan zones): name | status pill | cluster.
import stages from '../data/stages.json';
import screens from '../data/screens.json';
import StatusPill from './StatusPill.astro';

interface Props { stage: string }
const { stage } = Astro.props;
const st = stages.find((x) => x.key === stage);
if (!st) throw new Error(`no stage ${stage}`);
const pages = screens.filter((s) => s.stage === stage);
const A = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const nameKey = (n) => n.replace(/[^A-Za-z0-9]/g, '').toLowerCase();
const pageFor = (node) => {
	const tail = nameKey(node.name.split(' / ').pop());
	return pages.find((p) => nameKey(p.name).includes(tail) || tail.includes(nameKey(p.name).slice(0, 12)));
};
---
<div class="rows">
	{st.nodes.map((n) => {
		const pg = pageFor(n);
		const label = n.name.split(' / ').pop();
		return (
			<div class="row">
				<span class="nm">{pg ? <a href={`${A}tutor/${stage}/${pg.slug}/`}>{label}</a> : label}</span>
				<StatusPill status={n.status} label={n.statusLabel} />
				<span class="cl">{n.cluster}</span>
			</div>
		);
	})}
</div>
<style>
	.rows { border: 1px solid var(--sl-color-hairline); border-radius: var(--sifu-radius); background: #fff; overflow: hidden; margin-top: 1rem; }
	.row {
		display: grid; grid-template-columns: 1fr auto 9rem; gap: 0.8rem; align-items: center;
		padding: 0.55rem 1rem; border-bottom: 1px solid var(--sl-color-hairline-light); font-size: 0.85rem;
	}
	.row:last-child { border-bottom: 0; }
	.nm { font-weight: 600; color: var(--sl-color-white); }
	.nm a { text-decoration: none; color: var(--sl-color-accent); }
	.nm a:hover { text-decoration: underline; }
	.cl { color: var(--sl-color-gray-4); font-size: 0.72rem; text-align: right; }
	@media (max-width: 640px) { .row { grid-template-columns: 1fr auto; } .cl { display: none; } }
</style>
