---
// Mobbin-style flat scan of every approved frame, grouped by journey stage.
import screens from '../data/screens.json';
import stages from '../data/stages.json';
const A = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const groups = stages
	.map((st) => ({ st, items: screens.filter((s) => s.stage === st.key) }))
	.filter((gr) => gr.items.length);
const IMGVER = '?v=13jul-vpfix';
---

{groups.map(({ st, items }) => (
	<section>
		<h2>{st.num}. {st.title}{st.star ? ' ★' : ''}</h2>
		<div class="grid">
			{items.flatMap((s) =>
				s.states.map((state) => (
					<a class="tile" href={`${A}tutor/${s.stage}/${s.slug}/`}>
						<img src={A + state.after + IMGVER} alt={`${s.name} · ${state.label}`} loading="lazy" />
						<span class="cap"><b>{s.name.length > 26 ? s.name.slice(0, 24) + '…' : s.name}</b> · {state.label}</span>
					</a>
				))
			)}
		</div>
	</section>
))}

<style>
	.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1rem 0.8rem; }
	.tile { text-decoration: none; }
	.tile img {
		width: 100%; height: auto; border-radius: 0.8rem; border: 1px solid var(--sl-color-gray-5);
		transition: transform 0.12s ease;
	}
	.tile:hover img { transform: translateY(-3px); border-color: var(--sl-color-accent); }
	.tile .cap { display: block; font-size: 0.68rem; color: var(--sl-color-gray-3); margin-top: 0.3rem; line-height: 1.3; }
	.tile .cap b { color: var(--sl-color-gray-2); }
</style>
